# Cada variable dice dónde se necesita: «local» (.env de tu máquina) y/o
# «Vercel» (Settings → Environment Variables del proyecto). Los pasos de
# Vercel, en hwe-tools: docs/guias/deploy-vercel.md.

# ── Obligatorias ───────────────────────────────────────────────────────────

# Postgres. Local: tu Postgres o Docker (ver README.md), con una base de datos
# propia para cada site. Vercel: la cadena de conexión de Neon, de la
# integración de Postgres del Marketplace. La integración la inyecta como
# DATABASE_URL, y este site lee DATABASE_URI: crea DATABASE_URI con el mismo
# valor en el proyecto.
DATABASE_URI=postgres://postgres@127.0.0.1:5432/mi-site
# Solo en Vercel, en el entorno Production: el Build Command migra con la conexión
# directa (DATABASE_URL_UNPOOLED, que también inyecta Neon) y el site en ejecución
# usa la agrupada. Los detalles, en hwe-tools: docs/guias/deploy-vercel.md.

# Secreto usado por Payload para firmar JWT. Local y Vercel, uno distinto en cada
# entorno; nunca reutilices el de otro:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-random-string

# URL pública del site, sin barra final. La usan Payload, los metadatos y el
# JSON-LD del frontend. Vercel: la URL de producción, por ejemplo
# https://mi-site.vercel.app (sin ella, el JSON-LD no sale).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Instalación ────────────────────────────────────────────────────────────

# Token de GitHub con permiso `read:packages`, para que pnpm pueda descargar
# @hwe-platform/core-ui de GitHub Packages (lo lee .npmrc).
# Local: expórtalo en la terminal (o `setx` en Windows); pnpm install no lee
# este fichero. Vercel: OBLIGATORIA, también durante el build: sin ella,
# `pnpm install` falla con 401 antes de compilar nada.
# NODE_AUTH_TOKEN=

# ── Opcionales ─────────────────────────────────────────────────────────────

# Storage de media (DEC-010). Vercel: se crea sola al conectar el Blob store al
# proyecto, con formato vercel_blob_rw_<id>_<resto>. Con ella, `media` se guarda
# en Vercel Blob; vacía, en ./media, que es lo normal en local. No la rellenes en
# local salvo que quieras subir a Blob de verdad.
BLOB_READ_WRITE_TOKEN=

# SMTP del formulario de contacto. Sin SMTP_HOST, Payload escribe los emails en
# la consola en vez de mandarlos: es lo normal en local. En Vercel el demo no
# manda correo hasta que se configure un SMTP.
# 465 = TLS; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente. Sin ellas: no-reply@localhost y «Site». Descoméntalas solo con valor
# — una variable vacía cuenta como definida y dejaría el remitente en blanco.
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=
