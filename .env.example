# ── Obligatorias ───────────────────────────────────────────────────────────

# Postgres — local, Docker o gestionado (ver README.md). Una base de datos
# propia para cada site, no compartida con otros proyectos.
DATABASE_URI=postgres://postgres@127.0.0.1:5432/mi-site

# Secreto usado por Payload para firmar JWT. Genera uno propio en cada entorno,
# nunca reutilices el de otro:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-random-string

# URL pública del site, sin barra final. La usan Payload, los metadatos y el
# JSON-LD del frontend.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Instalación ────────────────────────────────────────────────────────────

# Token de GitHub con permiso `read:packages`, para que pnpm pueda descargar
# @hwe-platform/core-ui de GitHub Packages (lo lee .npmrc). Mejor exportarlo en
# la shell o en la CI que dejarlo aquí: pnpm install no lee este fichero.
# NODE_AUTH_TOKEN=

# ── Opcionales ─────────────────────────────────────────────────────────────

# Storage de media en producción (Vercel Blob). Todavía no la lee el código:
# el adapter que la activa llega con el deploy (HU-012). Sin ella, los ficheros
# se guardan en ./media, que es lo normal en local.
BLOB_READ_WRITE_TOKEN=

# SMTP del formulario de contacto. Sin SMTP_HOST, Payload escribe los emails en
# la consola en vez de mandarlos: es lo normal en local.
# 465 = TLS; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente. Sin ellas: no-reply@localhost y «Site». Descoméntalas solo con valor
# — una variable vacía cuenta como definida y dejaría el remitente en blanco.
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=
